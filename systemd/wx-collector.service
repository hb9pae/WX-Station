[Unit]
Description=WX-Station Sensor Collector & TCP Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/WX-Station
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u -m wx_station.collector -c /home/pi/WX-Station/config.yaml
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=10

# Security and resource hardening
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wx-collector

[Install]
WantedBy=multi-user.target
